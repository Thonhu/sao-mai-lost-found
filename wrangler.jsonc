{
  "name": "sao-mai-lost-found",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-08",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sao-mai-lost-found-db",
      "database_id": "da2c6621-5473-484b-a3bf-6e5fbef1051e"
    }
  ],

  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "sao-mai-lost-found-photos"
    }
  ]
}
